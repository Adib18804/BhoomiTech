# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bhoomitech

# Authentication
JWT_SECRET=change-this-to-a-secure-random-secret
AUTH_SECRET=change-this-to-another-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# NOTE: must be valid JSON (List[str]) — pydantic-settings parses complex
# dotenv values as JSON. Comma-separated strings will fail at startup.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Account Lockout (Phase 8) — lock the account after this many consecutive
# failed logins, for this many minutes. Successful login resets the counter.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate Limiting (Phase 9) — in-memory sliding window, per client IP (60s window).
# Auth limit applies to: login, admin/login, register, forgot-password.
# Verification limit applies to: POST /verification/check, GET /verification/{case_id}.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_VERIFICATION_PER_MINUTE=20

# API Configuration
API_V1_PREFIX=/api
PROJECT_NAME=BhoomiTech

# Frontend Environment (create .env.local in frontend/)
# VITE_API_BASE_URL=http://localhost:8000
